                                                            .card h3 { color: #8e583d; }
                                                                    .price { color: #d4a373; font-weight: bold; font-size: 18px; margin-bottom: 15px; }
                                                                            .whatsapp-btn { background-color: #25d366; color: white; padding: 10px 15px; border-radius: 10px; text-decoration: none; font-weight: bold; display: inline-block; }
                                                                                    .whatsapp-btn:hover { background-color: #128c7e; }
                                                                                        </style>
                                                                                        </head>
                                                                                        <body>
                                                                                            <header>
                                                                                                    <h1>مرحباً بكم في سكر للحلويات</h1>
                                                                                                        </header>
                                                                                                            <div class="container">
                                                                                                                    <div class="card">
                                                                                                                                <img src="your-sweets-image.jpg" alt="اسم المنتج">
