                                                                                                                                                                    <div class="price">٥٠ جنية</div>
                                                                                                                                                                                <a href="https://wa.me/201234567890?text=أريد طلب اسم المنتج" class="whatsapp-btn" target="_blank">اطلب عبر واتساب</a>
                                                                                                                                                                                        </div>
                                                                                                                                                                                                <!-- يمكنك تكرار هذا الجزء لإضافة منتجات أخرى -->
                                                                                                                                                                                                    </div>
