<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
        <title>سكر للحلويات</title>
            <style>
                    body { font-family: 'Cairo', sans-serif; text-align: center; margin: 0; padding: 20px; background-color: #f4e8e1; }
